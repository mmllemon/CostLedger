<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CostLedger.App.Views.AlertCenterView"
             Background="{StaticResource BgBrush}"
             FontFamily="Microsoft YaHei, Segoe UI, sans-serif">
  <TabControl Margin="14,14,14,14">
    <!-- ============ 预警 ============ -->
    <TabItem Header="预警">
      <Grid RowDefinitions="Auto,*" Margin="0,10,0,0">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
          <Button Classes="primary" Content="立即评估" Click="OnEvaluate"/>
          <CheckBox x:Name="OnlyUnacked" Content="仅未确认" IsChecked="True" Click="OnFilterChanged" VerticalAlignment="Center"/>
          <TextBlock x:Name="AlertStatus" VerticalAlignment="Center" Foreground="{StaticResource AccentDeepBrush}" FontSize="12.5"/>
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="440,*" Margin="0,10,0,0">
          <!-- 规则 -->
          <Border Grid.Column="0" Classes="sidecard" Margin="0,0,10,0">
            <Grid RowDefinitions="Auto,180,Auto,*">
              <TextBlock Grid.Row="0" Classes="label" Text="预警规则"/>
              <ListBox x:Name="RuleList" Grid.Row="1" Margin="0,8,0,0" Background="Transparent"
                       BorderThickness="0" SelectionChanged="OnRuleSelected"/>
              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,8">
                <Button Classes="pill" Content="新增" Click="OnRuleNew"/>
                <Button Classes="primary" Content="保存" Click="OnRuleSave"/>
                <Button Classes="danger" Content="删除" Click="OnRuleDelete"/>
              </StackPanel>
              <StackPanel Grid.Row="3" Spacing="6">
                <Grid ColumnDefinitions="64,*">
                  <TextBlock Grid.Column="0" Text="规则名" VerticalAlignment="Center"/>
                  <TextBox x:Name="RName" Grid.Column="1"/>
                </Grid>
                <Grid ColumnDefinitions="64,*,64,*">
                  <TextBlock Grid.Column="0" Text="指标" VerticalAlignment="Center"/>
                  <ComboBox x:Name="RMetric" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
                  <TextBlock Grid.Column="2" Text="级别" VerticalAlignment="Center"/>
                  <ComboBox x:Name="RSeverity" Grid.Column="3" HorizontalAlignment="Stretch"/>
                </Grid>
                <Grid ColumnDefinitions="64,*,64,*">
                  <TextBlock Grid.Column="0" Text="运算符" VerticalAlignment="Center"/>
                  <ComboBox x:Name="ROp" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
                  <TextBlock Grid.Column="2" Text="阈值" VerticalAlignment="Center"/>
                  <NumericUpDown x:Name="RThreshold" Grid.Column="3" Minimum="-99999999" Maximum="99999999"/>
                </Grid>
                <CheckBox x:Name="REnabled" Content="启用该规则" IsChecked="True"/>
              </StackPanel>
            </Grid>
          </Border>
          <!-- 预警记录 -->
          <Border Grid.Column="1" Classes="sidecard">
            <Grid RowDefinitions="Auto,*,Auto">
              <TextBlock Grid.Row="0" Classes="label" Text="预警记录"/>
              <ListBox x:Name="AlertList" Grid.Row="1" Margin="0,8,0,0" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                 Foreground="{Binding Severity, Converter={StaticResource KpiBrush}}"/>
                      <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"
                                 Foreground="{StaticResource Txt2Brush}"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Grid.Row="2" Classes="pill" Content="确认选中" Click="OnAck" Margin="0,8,0,0" HorizontalAlignment="Left"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </TabItem>

    <!-- ============ 计划任务 ============ -->
    <TabItem Header="计划任务">
      <Grid ColumnDefinitions="300,1*" Margin="0,10,0,0">
        <Border Grid.Column="0" Classes="sidecard" Margin="0,0,10,0">
          <Grid RowDefinitions="Auto,1*,Auto">
            <TextBlock Grid.Row="0" Classes="label" Text="任务列表"/>
            <ListBox x:Name="TaskList" Grid.Row="1" Margin="0,8,0,0" Background="Transparent"
                     BorderThickness="0" SelectionChanged="OnTaskSelected"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Classes="pill" Content="新增" Click="OnTaskNew"/>
              <Button Classes="danger" Content="删除" Click="OnTaskDelete"/>
            </StackPanel>
          </Grid>
        </Border>
        <ScrollViewer Grid.Column="1">
          <Border Classes="card" HorizontalAlignment="Left">
            <StackPanel Spacing="10" Width="460">
              <TextBlock Classes="label" Text="计划任务（按间隔自动运行）"/>
              <Grid ColumnDefinitions="90,*">
                <TextBlock Grid.Column="0" Text="名称" VerticalAlignment="Center"/>
                <TextBox x:Name="TName" Grid.Column="1"/>
              </Grid>
              <Grid ColumnDefinitions="90,*,90,*">
                <TextBlock Grid.Column="0" Text="间隔(分钟)" VerticalAlignment="Center"/>
                <NumericUpDown x:Name="TInterval" Grid.Column="1" Minimum="1" Maximum="10080" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="2" Text="最近运行" VerticalAlignment="Center"/>
                <TextBlock x:Name="TLast" Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource Txt2Brush}"/>
              </Grid>
              <CheckBox x:Name="TEnabled" Content="启用该任务" IsChecked="True"/>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="primary" Content="保存" Click="OnTaskSave"/>
                <Button Classes="pill" Content="立即运行" Click="OnTaskRun"/>
                <TextBlock x:Name="TaskStatus" VerticalAlignment="Center" Foreground="{StaticResource AccentDeepBrush}" FontSize="12.5"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </Grid>
    </TabItem>
  </TabControl>
</UserControl>
