<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CostLedger.App.Views.DashboardView"
             Margin="0,16,18,16">
  <StackPanel Spacing="14">
    <!-- KPI 卡片（数据驱动：显隐/顺序/阈值由「看板设计」配置） -->
    <ItemsControl ItemsSource="{Binding Cards}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="card" Width="220" Margin="0,0,12,12">
            <StackPanel>
              <TextBlock Text="{Binding Title}" Classes="label"/>
              <TextBlock Text="{Binding ValueText}" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"
                         Foreground="{Binding Severity, Converter={StaticResource KpiBrush}}"/>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 成本脊柱列表 -->
    <Border Classes="card">
      <StackPanel>
        <TextBlock Text="成本脊柱（按科目归集）" FontSize="14.5" FontWeight="Bold" Margin="0,0,0,10"/>
        <Grid ColumnDefinitions="1.3*,1*,1*,1.1*,1.1*,1.4*" Margin="0,0,0,6">
          <TextBlock Grid.Column="0" Classes="label" Text="科目"/>
          <TextBlock Grid.Column="1" Classes="label" Text="目标"/>
          <TextBlock Grid.Column="2" Classes="label" Text="已发生"/>
          <TextBlock Grid.Column="3" Classes="label" Text="预计最终"/>
          <TextBlock Grid.Column="4" Classes="label" Text="偏差"/>
          <TextBlock Grid.Column="5" Classes="label" Text="进度"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding Lines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="1.3*,1*,1*,1.1*,1.1*,1.4*" Margin="0,8">
                <TextBlock Grid.Column="0" Text="{Binding CostCategoryName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Target, StringFormat='{}{0:N0}'}" VerticalAlignment="Center" Foreground="{StaticResource Txt2Brush}"/>
                <TextBlock Grid.Column="2" Text="{Binding Incurred, StringFormat='{}{0:N0}'}" VerticalAlignment="Center" Foreground="{StaticResource Txt2Brush}"/>
                <TextBlock Grid.Column="3" Text="{Binding EstimatedFinal, StringFormat='{}{0:N0}'}" VerticalAlignment="Center" Foreground="{StaticResource Txt2Brush}"/>
                <TextBlock Grid.Column="4" VerticalAlignment="Center"
                           Text="{Binding Variance, StringFormat='{}{0:N0}'}"
                           Foreground="{Binding IsOver, Converter={StaticResource OverForeground}}"
                           FontWeight="Bold"/>
                <ProgressBar Grid.Column="5" Classes="line" Value="{Binding Progress}" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
