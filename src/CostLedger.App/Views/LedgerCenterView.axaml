<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CostLedger.App.Views.LedgerCenterView"
             Background="{StaticResource BgBrush}"
             FontFamily="Microsoft YaHei, Segoe UI, sans-serif">
  <Grid ColumnDefinitions="220,1*" Margin="16,16,16,16">
    <Border Grid.Column="0" Classes="sidecard" Margin="0,0,10,0">
      <StackPanel Spacing="10">
        <TextBlock Classes="label" Text="台账"/>
        <ListBox x:Name="LedgerList" Background="Transparent" BorderThickness="0" SelectionChanged="OnLedgerSelected"/>
      </StackPanel>
    </Border>

    <StackPanel Grid.Column="1" Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="项目" VerticalAlignment="Center" Foreground="{StaticResource Txt2Brush}"/>
        <ComboBox x:Name="ProjCombo" Width="280" SelectionChanged="OnProjectChanged"/>
        <Button Classes="primary" Content="打印此台账" Click="OnPrint"/>
        <TextBlock x:Name="LedgerTitle" VerticalAlignment="Center" FontWeight="Bold"/>
      </StackPanel>
      <Border Classes="card">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="560">
          <Grid x:Name="LedgerHost" Margin="0,4,0,0"/>
        </ScrollViewer>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
