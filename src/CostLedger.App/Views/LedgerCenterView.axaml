<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CostLedger.App.Views.LedgerCenterView"
             Background="{StaticResource BgBrush}"
             FontFamily="Microsoft YaHei, Segoe UI, sans-serif">
  <Grid ColumnDefinitions="220,1*" Margin="16,16,16,16">
    <Border Grid.Column="0" Classes="sidecard" Margin="0,0,10,0">
      <StackPanel Spacing="10">
        <TextBlock Classes="label" Text="台账"/>
        <ListBox x:Name="LedgerList" Background="Transparent" BorderThickness="0" SelectionChanged="OnLedgerSelected"/>
      </StackPanel>
    </Border>

    <StackPanel Grid.Column="1" Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="项目" VerticalAlignment="Center" Foreground="{StaticResource Txt2Brush}"/>
        <ComboBox x:Name="ProjCombo" Width="260" SelectionChanged="OnProjectChanged"/>
        <TextBlock x:Name="LedgerTitle" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBox x:Name="FilterBox" Width="200" Watermark="筛选（关键字）" TextChanged="OnFilterChanged" VerticalAlignment="Center"/>
        <Button Classes="primary" Content="打印此台账" Click="OnPrint"/>
        <Button Classes="pill" Content="导出 CSV" Click="OnExport"/>
        <Button Classes="pill" Content="导入 CSV" Click="OnImport"/>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12.5"
                   Foreground="{StaticResource AccentDeepBrush}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
        <Button x:Name="PrevPage" Classes="pill" Content="上一页" Click="OnPrevPage"/>
        <Button x:Name="NextPage" Classes="pill" Content="下一页" Click="OnNextPage"/>
        <TextBlock x:Name="PageLabel" VerticalAlignment="Center" FontSize="12.5"
                   Foreground="{StaticResource Txt2Brush}"/>
      </StackPanel>
      <Border Classes="card">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="520">
          <Grid x:Name="LedgerHost" Margin="0,4,0,0"/>
        </ScrollViewer>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
