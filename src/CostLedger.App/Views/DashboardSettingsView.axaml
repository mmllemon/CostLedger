<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CostLedger.App.Views.DashboardSettingsView"
             Background="{StaticResource BgBrush}"
             FontFamily="Microsoft YaHei, Segoe UI, sans-serif">
  <ScrollViewer Margin="16,16,16,16">
    <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Left">
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="label" Text="看板设计（成本看板 KPI 卡片）"/>
          <TextBlock Text="勾选要在看板显示的指标；可改标题、顺序与阈值。阈值达到即变色（越大越差的指标：超过阈值告警；越小越差的指标：低于阈值告警）。"
                     Foreground="{StaticResource Txt2Brush}" FontSize="12.5" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="60,*,56,110,110" Margin="0,6,0,0">
            <TextBlock Grid.Column="0" Classes="label" Text="显示"/>
            <TextBlock Grid.Column="1" Classes="label" Text="标题"/>
            <TextBlock Grid.Column="2" Classes="label" Text="序"/>
            <TextBlock Grid.Column="3" Classes="label" Text="预警阈值"/>
            <TextBlock Grid.Column="4" Classes="label" Text="告警阈值"/>
          </Grid>
          <StackPanel x:Name="RowsHost" Spacing="8"/>
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
            <Button Classes="primary" Content="保存" Click="OnSave"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource AccentDeepBrush}" FontSize="12.5"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
