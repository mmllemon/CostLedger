<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CostLedger.App.Views.PartyLedgerView"
             Background="{StaticResource BgBrush}"
             FontFamily="Microsoft YaHei, Segoe UI, sans-serif">
  <ScrollViewer Margin="16,16,16,16">
    <StackPanel Spacing="14">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="往来单位" VerticalAlignment="Center" Foreground="{StaticResource Txt2Brush}"/>
        <ComboBox x:Name="PartyCombo" Width="320" SelectionChanged="OnPartyChanged"/>
        <Button Classes="primary" Content="打印此单位台账" Click="OnPrint"/>
        <TextBlock x:Name="PartyTitle" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"/>
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="label" Text="汇总（跨全部项目）"/>
          <WrapPanel x:Name="SummaryHost"/>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="label" Text="按项目"/>
          <Grid x:Name="ProjectHost"/>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="label" Text="合同明细"/>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" MaxHeight="320">
            <Grid x:Name="ContractHost"/>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
