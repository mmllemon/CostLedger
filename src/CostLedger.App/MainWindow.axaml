<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CostLedger.App.Views"
        x:Class="CostLedger.App.MainWindow"
        Title="成本台账 · CostLedger"
        Width="1180" Height="760"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei, Segoe UI, sans-serif">
  <Grid ColumnDefinitions="208,1*">
    <!-- 侧栏 -->
    <StackPanel Grid.Column="0" Margin="14,16">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,6,6,18">
        <Border Classes="brandmark"><TextBlock Text="诺"/></Border>
        <TextBlock Text="诺亨成本" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>
      <Button Classes="nav on" Content="成本看板"/>
      <Button Classes="nav" Content="合同台账"/>
      <Button Classes="nav" Content="计量签证"/>
      <Button Classes="nav" Content="成本脊柱"/>
      <Button Classes="nav" Content="资金付款"/>
      <Button Classes="nav" Content="对账中心"/>
      <Button Classes="nav" Content="报表中心"/>
      <Button Classes="nav" Content="系统设置"/>
    </StackPanel>

    <!-- 主区 -->
    <Grid Grid.Column="1" RowDefinitions="Auto,1*">
      <Grid Grid.Row="0" ColumnDefinitions="1*,Auto" Margin="0,16,18,0">
        <StackPanel>
          <TextBlock Text="成本看板 / 总览" Classes="label"/>
          <TextBlock Text="下午好，李工" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Classes="pill"><TextBlock Text="本月"/></Button>
          <Button Classes="icon">
            <PathIcon Data="M12 2a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 12c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5z"/>
          </Button>
        </StackPanel>
      </Grid>
      <views:DashboardView Grid.Row="1" x:Name="Dashboard"/>
    </Grid>
  </Grid>
</Window>
