<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CostLedger.App.Views"
        x:Class="CostLedger.App.MainWindow"
        Title="成本台账 · CostLedger"
        Width="1180" Height="760"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei, Segoe UI, sans-serif">
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="208,1*">
    <!-- 全局栏：公司 + 当前项目切换 + 数据截至 -->
    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
            Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
            Padding="16,10">
      <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <TextBlock Text="公司" VerticalAlignment="Center" Foreground="{StaticResource Txt3Brush}" FontSize="12"/>
        <TextBlock Text="诺亨造价" VerticalAlignment="Center" FontWeight="Bold" FontSize="13"/>
        <TextBlock Text="当前项目" VerticalAlignment="Center" Foreground="{StaticResource Txt3Brush}" FontSize="12" Margin="10,0,0,0"/>
        <ComboBox x:Name="ProjectSwitcher" Width="360" SelectionChanged="OnProjectSwitcherChanged"/>
        <TextBlock x:Name="AsOfText" VerticalAlignment="Center" Foreground="{StaticResource Txt3Brush}" FontSize="12" Margin="10,0,0,0"/>
      </StackPanel>
    </Border>

    <!-- 侧栏（可滚动，避免下方导航在矮窗口不可达） -->
    <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
    <StackPanel Margin="14,16">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,6,6,18">
        <Border Classes="brandmark"><TextBlock Text="诺"/></Border>
        <TextBlock Text="诺亨成本" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="公司" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Txt3Brush}" Margin="12,6,0,4"/>
      <Button x:Name="NavCompany" Classes="nav" Content="公司经营驾驶舱" Click="OnNavClick"/>
      <Button x:Name="NavProjects" Classes="nav" Content="项目管理" Click="OnNavClick"/>
      <TextBlock Text="项目经营" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Txt3Brush}" Margin="12,10,0,4"/>
      <Button x:Name="NavCockpit" Classes="nav" Content="项目经济驾驶舱" Click="OnNavClick"/>
      <Button x:Name="NavCostControl" Classes="nav" Content="成本控制项与归属" Click="OnNavClick"/>
      <Button x:Name="NavRegister" Classes="nav" Content="板块金额登记" Click="OnNavClick"/>
      <Button x:Name="NavForecast" Classes="nav" Content="成本预测版本" Click="OnNavClick"/>
      <Button x:Name="NavChangeItems" Classes="nav" Content="变化事项" Click="OnNavClick"/>
      <TextBlock Text="往来与报表" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Txt3Brush}" Margin="12,10,0,4"/>
      <Button x:Name="NavParties" Classes="nav" Content="往来单位全景" Click="OnNavClick"/>
      <Button x:Name="NavReports" Classes="nav" Content="内部汇报报表" Click="OnNavClick"/>
      <Button x:Name="NavExternalResults" Classes="nav" Content="结算结果分析" Click="OnNavClick"/>
      <TextBlock Text="后台" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Txt3Brush}" Margin="12,10,0,4"/>
      <Button x:Name="NavAdmin" Classes="nav" Content="后台管理" Click="OnNavClick"/>
      <Button x:Name="NavSettings" Classes="nav" Content="系统设置" Click="OnNavClick"/>

      <!-- 旧模块（M2 兼容）：默认折叠，避免与成本岗新定位混淆；需要时展开。 -->
      <Expander Header="旧模块（兼容）" FontSize="10.5" Foreground="{StaticResource Txt3Brush}" Margin="6,14,6,0" HorizontalAlignment="Stretch">
        <StackPanel>
          <Button x:Name="NavDashboard" Classes="nav" Content="成本看板" Click="OnNavClick"/>
          <Button x:Name="NavOverview" Classes="nav" Content="项目总览" Click="OnNavClick"/>
          <Button x:Name="NavLedgers" Classes="nav" Content="台账中心" Click="OnNavClick"/>
          <Button x:Name="NavCost" Classes="nav" Content="成本结构" Click="OnNavClick"/>
          <Button x:Name="NavMaster" Classes="nav" Content="基础资料" Click="OnNavClick"/>
          <Button x:Name="NavDocs" Classes="nav" Content="业务单据" Click="OnNavClick"/>
          <Button x:Name="NavProject" Classes="nav" Content="项目" Click="OnNavClick"/>
          <Button x:Name="NavCategory" Classes="nav" Content="成本科目" Click="OnNavClick"/>
          <Button x:Name="NavBoardDesign" Classes="nav" Content="看板设计" Click="OnNavClick"/>
          <Button x:Name="NavAlerts" Classes="nav" Content="预警中心" Click="OnNavClick"/>
          <Button x:Name="NavRecon" Classes="nav" Content="对账中心" Click="OnNavClick"/>
          <Button x:Name="NavObjects" Classes="nav" Content="自建对象" Click="OnNavClick"/>
        </StackPanel>
      </Expander>
    </StackPanel>
    </ScrollViewer>

    <!-- 主区 -->
    <ContentControl Grid.Row="1" Grid.Column="1" x:Name="MainArea" Margin="0,0,0,0"/>
  </Grid>
</Window>
